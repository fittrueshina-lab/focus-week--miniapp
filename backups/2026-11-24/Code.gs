/** FOCUS Mini App → Sheets API bridge. The Google Sheet is accessed by a dedicated service account, not by the signed-in user's broad Sheets permission. */
var REPORTS_SPREADSHEET_ID='1C0M094mlXAAwKJ32tUkCq8DEpDLlF8z2tNFbWPDTMLU';
var REPORTS_SHEET_NAME='Недельные отчёты';
var REPORT_PERIOD_MS=72*60*60*1000, MAX_REPORT_WEEKS=16, MAX_INIT_DATA_AGE_SECONDS=3600;
var REPORT_HEADERS=['ID отчёта','Telegram ID','Дата сохранения','Неделя программы','Средние ккал за неделю','Средний вес за неделю, кг','Минимальный вес за неделю, кг','Шея (ОШ), см','Талия (ОТ), см','Бёдра (ОБ), см','Среднее количество шагов','Уровень голода','Самочувствие','Точность FatSecret (1–5)','Лёгкость соблюдения плана (1–5)','Количество тренировок','Месячные с прошлого отчёта','Дата начала месячных','Комментарий'];
function doGet(e){var p=(e&&e.parameter)||{},cb=safeCallback_(p.callback);try{if(p.action!=='reports')throw Error('BAD_REQUEST');return jsonp_(cb,{ok:true,reports:readReportsForUser_(verifyTelegramInitData_(p.initData||''))});}catch(err){return jsonp_(cb,{ok:false,error:publicError_(err)});}}
function doPost(e){try{var raw=e&&e.postData&&e.postData.contents;if(!raw||raw.length>20000)throw Error('BAD_REQUEST');var req=JSON.parse(raw);if(req.action!=='saveReport')throw Error('BAD_REQUEST');var userId=verifyTelegramInitData_(req.initData||''),r=req.report||{},id=cleanText_(r.reportId,80);if(!/^[A-Za-z0-9_-]{8,80}$/.test(id))throw Error('BAD_REPORT');var date=new Date(r.date);if(!Number.isFinite(date.getTime())||date.getTime()>Date.now()+60000)throw Error('BAD_REPORT');var d=r.data||{},row=[id,userId,date.toISOString(),0,numberOrDash_(d.kcal),numberOrDash_(d.avg),numberOrDash_(d.min),numberOrDash_(d.neck),numberOrDash_(d.waist),numberOrDash_(d.hips),numberOrDash_(d.steps),safeSheetText_(d.hunger,100),safeSheetText_(d.feel,100),numberOrDash_(d.fatsecret),numberOrDash_(d.ease),numberOrDash_(d.work),safeSheetText_(d.cycle,100),safeSheetText_(d.cycleDate,40),safeSheetText_(d.comment,5000)];var lock=LockService.getScriptLock();lock.waitLock(10000);try{var rows=readSheetValues_(),entries=[];for(var i=1;i<rows.length;i++){if(String(rows[i][0]||'')===id){if(String(rows[i][1]||'')!==userId)throw Error('BAD_REPORT');return jsonOutput_({ok:true,duplicate:true,reportId:id});}if(String(rows[i][1]||'')===userId)entries.push({row:i+1,date:new Date(rows[i][2]),reportId:String(rows[i][0])});}entries.push({row:-1,date:date,reportId:id});var planned=assignProgramWeeks_(entries);if(!planned[id]||planned[id]>MAX_REPORT_WEEKS)throw Error('LIMIT_REACHED');appendSheetRow_(row);entries[entries.length-1].row=rows.length+1;var weeks=assignProgramWeeks_(entries);updateWeeks_(entries,weeks);return jsonOutput_({ok:true,reportId:id,week:weeks[id]});}finally{lock.releaseLock();}}catch(err){return jsonOutput_({ok:false,error:publicError_(err)});}}
function verifyTelegramInitData_(raw){var token=PropertiesService.getScriptProperties().getProperty('TELEGRAM_BOT_TOKEN');if(!token)throw Error('NOT_CONFIGURED');if(!raw||raw.length>4096)throw Error('UNAUTHORIZED');var p=parseQuery_(raw),hash=String(p.hash||'').toLowerCase();if(!/^[a-f0-9]{64}$/.test(hash))throw Error('UNAUTHORIZED');delete p.hash;delete p.signature;var check=Object.keys(p).sort().map(function(k){return k+'='+p[k];}).join('\n'),secret=Utilities.computeHmacSha256Signature(token,'WebAppData'),sig=bytesToHex_(Utilities.computeHmacSha256Signature(check,secret));if(!constantTimeEqual_(sig,hash))throw Error('UNAUTHORIZED');var auth=Number(p.auth_date||0),now=Math.floor(Date.now()/1000);if(!auth||auth>now+60||now-auth>MAX_INIT_DATA_AGE_SECONDS)throw Error('UNAUTHORIZED');var user;try{user=JSON.parse(p.user||'{}');}catch(_){throw Error('UNAUTHORIZED');}var id=user&&user.id!=null?String(user.id):'';if(!/^\d{1,24}$/.test(id))throw Error('UNAUTHORIZED');return id;}
function readReportsForUser_(userId){var rows=readSheetValues_();if(rows.length<2)return[];return rows.slice(1).filter(function(r){return String(r[1]||'')===userId;}).map(function(r){return{reportId:String(r[0]||''),date:String(r[2]||''),week:Number(r[3])||1,data:{kcal:r[4],avg:r[5],min:r[6],neck:r[7],waist:r[8],hips:r[9],steps:r[10],hunger:r[11],feel:r[12],fatsecret:r[13],ease:r[14],work:r[15],cycle:r[16],cycleDate:r[17],comment:r[18]}};}).sort(function(a,b){return new Date(a.date)-new Date(b.date);});}
function initialize(){var sa=serviceAccountConfig_();if(!sa.client_email||!sa.private_key)throw Error('NOT_CONFIGURED');var rows=readSheetValues_();if(!rows.length||REPORT_HEADERS.some(function(h,i){return rows[0][i]!==h;}))throw Error('NOT_CONFIGURED');return'FOCUS report sheet is ready';}
function readSheetValues_(){return sheetsApi_('get','/values/'+encodeURIComponent("'"+REPORTS_SHEET_NAME.replace(/'/g,"''")+"'!A:S")).values||[];}
function appendSheetRow_(row){sheetsApi_('post','/values/'+encodeURIComponent("'"+REPORTS_SHEET_NAME.replace(/'/g,"''")+"'!A:S")+':append?valueInputOption=RAW&insertDataOption=INSERT_ROWS',{values:[row]});}
function updateWeeks_(entries,weeks){var data=entries.filter(function(x){return x.row>1;}).map(function(x){return{range:"'"+REPORTS_SHEET_NAME.replace(/'/g,"''")+"'!D"+x.row,values:[[weeks[x.reportId]]]};});if(data.length)sheetsApi_('post','/values:batchUpdate',{valueInputOption:'RAW',data:data});}
function sheetsApi_(method,path,body){var o={method:method,headers:{Authorization:'Bearer '+serviceAccountAccessToken_()},muteHttpExceptions:true};if(body){o.contentType='application/json';o.payload=JSON.stringify(body);}var res=UrlFetchApp.fetch('https://sheets.googleapis.com/v4/spreadsheets/'+REPORTS_SPREADSHEET_ID+path,o),status=res.getResponseCode();if(status<200||status>=300)throw Error('SHEETS_API_ERROR');var text=res.getContentText();return text?JSON.parse(text):{};}
function serviceAccountAccessToken_(){var cache=CacheService.getScriptCache(),cached=cache.get('focus_sheets_access_token');if(cached)return cached;var sa=serviceAccountConfig_();if(!sa.client_email||!sa.private_key)throw Error('NOT_CONFIGURED');var now=Math.floor(Date.now()/1000),header=base64UrlJson_({alg:'RS256',typ:'JWT'}),claim=base64UrlJson_({iss:sa.client_email,scope:'https://www.googleapis.com/auth/spreadsheets',aud:'https://oauth2.googleapis.com/token',iat:now,exp:now+3600}),unsigned=header+'.'+claim,signature=Utilities.computeRsaSha256Signature(unsigned,sa.private_key),assertion=unsigned+'.'+Utilities.base64EncodeWebSafe(signature).replace(/=+$/,'');var res=UrlFetchApp.fetch('https://oauth2.googleapis.com/token',{method:'post',payload:{grant_type:'urn:ietf:params:oauth:grant-type:jwt-bearer',assertion:assertion},muteHttpExceptions:true});if(res.getResponseCode()<200||res.getResponseCode()>=300)throw Error('SERVICE_ACCOUNT_AUTH');var token=JSON.parse(res.getContentText());if(!token.access_token)throw Error('SERVICE_ACCOUNT_AUTH');cache.put('focus_sheets_access_token',token.access_token,Math.min(Number(token.expires_in)-60,21600));return token.access_token;}
function serviceAccountConfig_(){var raw=PropertiesService.getScriptProperties().getProperty('GOOGLE_SERVICE_ACCOUNT_JSON');if(!raw)throw Error('NOT_CONFIGURED');try{return JSON.parse(raw);}catch(_){throw Error('NOT_CONFIGURED');}}
function base64UrlJson_(x){return Utilities.base64EncodeWebSafe(JSON.stringify(x),Utilities.Charset.UTF_8).replace(/=+$/,'');}
function assignProgramWeeks_(entries){var sorted=entries.slice().sort(function(a,b){return a.date.getTime()-b.date.getTime();}),week=0,anchor=null,result={};sorted.forEach(function(x){var t=x.date.getTime();if(!Number.isFinite(t))throw Error('BAD_REPORT');if(anchor===null||t-anchor>=REPORT_PERIOD_MS){week++;anchor=t;}result[x.reportId]=week;});return result;}
function parseQuery_(q){var r={};String(q).split('&').forEach(function(x){if(!x)return;var i=x.indexOf('='),k=i<0?x:x.slice(0,i),v=i<0?'':x.slice(i+1);r[decodeURIComponent(k.replace(/\+/g,' '))]=decodeURIComponent(v.replace(/\+/g,' '));});return r;}
function numberOrDash_(v){var t=String(v==null?'':v).trim();if(!t||t==='—'||t==='-')return'—';var n=Number(t.replace(/\s/g,'').replace(',','.'));return Number.isFinite(n)?n:'—';}
function safeSheetText_(v,max){var t=cleanText_(v,max);return/^[=+\-@]/.test(t)?"'"+t:t;}
function cleanText_(v,max){return String(v==null?'':v).trim().slice(0,max);}
function bytesToHex_(a){return a.map(function(b){var n=(b+256)%256;return('0'+n.toString(16)).slice(-2);}).join('');}
function constantTimeEqual_(a,b){if(a.length!==b.length)return false;var d=0;for(var i=0;i<a.length;i++)d|=a.charCodeAt(i)^b.charCodeAt(i);return d===0;}
function safeCallback_(x){var c=String(x||'');return/^focusGoogleCallback[A-Za-z0-9_]{1,64}$/.test(c)?c:'';}
function jsonp_(cb,x){var s=JSON.stringify(x);return cb?ContentService.createTextOutput(cb+'('+s+');').setMimeType(ContentService.MimeType.JAVASCRIPT):jsonOutput_(x);}
function jsonOutput_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
function publicError_(e){var m=String(e&&e.message||'ERROR');return['UNAUTHORIZED','NOT_CONFIGURED','LIMIT_REACHED','BAD_REQUEST','BAD_REPORT'].indexOf(m)>=0?m:'ERROR';}